# Genie 环境配置模板
# 复制此文件为 .env 并填写真实值

# AI Provider
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# 数据库 (默认SQLite)
DATABASE_URL=sqlite:///./genie.db
REDIS_URL=redis://localhost:6379/0

# 鉴权 (本地开发可关闭)
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
